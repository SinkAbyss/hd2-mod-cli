<Project Sdk="Microsoft.NET.Sdk">

  <!-- HD2 Mod Quick Deploy: the window over the core (..\..\core). WPF on the .NET
       Framework 4.8 every Windows 10 (1903+) and 11 has; the look of HD2 Mod
       Setting GUI. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>HD2 Mod Quick Deploy</AssemblyName>
    <RootNamespace>QuickDeploy</RootNamespace>
    <Version>0.10.0</Version>
    <Product>HD2 Mod Quick Deploy</Product>
    <Company>pat-pat-patrick</Company>
    <Copyright>MIT License</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- no paths of the build machine in the exe -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=src</PathMap>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>


  <!-- a build with another output path (the no-nexus build) must still ignore the
       default obj\ and bin\, or their generated files are compiled twice -->
  <ItemGroup>
    <Compile Remove="bin\**" />
    <Compile Remove="obj\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\core\*.cs" Link="core\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="logo.png" />
  </ItemGroup>

</Project>
